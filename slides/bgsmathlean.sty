% bgsmathlean.sty: shared look for all four sessions of
% "From Paper to Proof: Formalizing Mathematics in Lean with AI" (BGSMath, 2026).
%
% Build with pdfLaTeX. Lean code is set with listings and lstlean.tex (no shell escape needed).
% Every session loads this file and sets \leanfile{<file>.lean}; code is then cut
% out of that file by tag, so the slides only ever show code that compiles.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bgsmathlean}[2026/10/18 BGSMath Lean course slides]

