% moreliterate={...}: literate replacements added to those of lstlean.tex.
\lst@Key{moreliterate}{}{\expandafter\def\expandafter\lst@literate\expandafter{\lst@literate#1}}
\providecommand{\notni}{\not\ni}% the one symbol of lstlean.tex no loaded package has
\lstdefinestyle{bgslean}{language=lean, basicstyle=\ttfamily\footnotesize,
  moreliterate={{𝓝}{{\ensuremath{\mathcal{N}}}}1 {⋮}{{\ensuremath{\vdots}}}1
