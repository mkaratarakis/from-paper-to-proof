% Session plan: \sessionplan{<current session number>}
\newcommand{\sessionplan}[1]{%
  \renewcommand{\arraystretch}{1.35}%
  \begin{tabularx}{\linewidth}{@{}c>{\raggedright\arraybackslash}p{0.27\linewidth}X@{}}
    \toprule
    & \textbf{Session} & \textbf{Content}\\\midrule
    \bgs@row{1}{#1}{Lean and Mathlib}{What formalizing means, and does not mean; first proofs; finding things in Mathlib; reading a Lean statement}
    \bgs@row{2}{#1}{From paper to Lean}{Writing definitions and statements; the usual mistakes; drafting statements with AI and checking them}
    \bgs@row{3}{#1}{AI tools}{What AI did this year; an agent proving a statement, live; checking what it hands back}
    \bgs@row{4}{#1}{Your own theorem}{Statements sent in by participants, formalized live; how to do your own at home}
    \bottomrule
  \end{tabularx}}
\newcommand{\bgs@row}[4]{%
  \ifnum#1=#2 \rowcolor{leansky}\fi
  \textbf{#1} & #3 & {\small #4}\\}

