  numbers=left, numbersep=0pt, firstnumber=1, numberstyle=\bgs@hlline}
\lstset{style=bgslean}

% \leanfile{Session1.lean}: the session's Lean file, next to the slides (Overleaf, flat
% layout) or in ../BGSMath/ (the repository).
\newcommand*{\bgs@leanfile}{}
\newcommand{\leanfile}[1]{%
  \IfFileExists{#1}{\renewcommand*{\bgs@leanfile}{#1}}{%
    \IfFileExists{../BGSMath/#1}{\renewcommand*{\bgs@leanfile}{../BGSMath/#1}}{%
      \PackageError{bgsmathlean}{Lean file #1 not found in . or ../BGSMath/}{}}}}

% highlightlines=4 or highlightlines={1-3}, highlightcolor=<colour>: a bar behind
% those lines of a listing. It is drawn by the line-number hook; numbers are not shown.
\def\bgs@hlparse#1-#2\@nil{\def\bgs@hlfrom{#1}%
  \ifx\@nil#2\@nil\def\bgs@hlto{#1}\else\bgs@hlparseto#2\@nil\fi}
\def\bgs@hlparseto#1-\@nil{\def\bgs@hlto{#1}}
\lst@Key{highlightlines}{0}{\bgs@hlparse#1-\@nil}
\lst@Key{highlightcolor}{goalbg}{\def\bgs@hlcolor{#1}}
\newcommand{\bgs@hlline}[1]{%
  \ifnum#1<\bgs@hlfrom\relax\else\ifnum#1>\bgs@hlto\relax\else
    \hspace*{-4pt}\rlap{\color{\bgs@hlcolor}%
      \rule[-0.3\baselineskip]{\dimexpr\linewidth+8pt}{\baselineskip}}%
  \fi\fi}

% \bgs@cut{<file>}{<tag>}: copy the lines between `-- !begin <tag>` and `-- !end <tag>`
% to <jobname>-snippet.lean.
\ExplSyntaxOn
\ior_new:N \g__bgs_ior
\iow_new:N \g__bgs_iow
\bool_new:N \l__bgs_in_bool
\cs_new_protected:Npn \bgs@cut #1 #2
  {
    \bool_set_false:N \l__bgs_in_bool
    \iow_open:Nn \g__bgs_iow { \c_sys_jobname_str -snippet.lean }
    \ior_open:Nn \g__bgs_ior {#1}
    \ior_str_map_inline:Nn \g__bgs_ior
      {
        \str_if_eq:nnT {##1} { -- ~ !end ~ #2 } { \bool_set_false:N \l__bgs_in_bool }
        \bool_if:NT \l__bgs_in_bool { \iow_now:Nn \g__bgs_iow {##1} }
        \str_if_eq:nnT {##1} { -- ~ !begin ~ #2 } { \bool_set_true:N \l__bgs_in_bool }
      }
    \ior_close:N \g__bgs_ior
    \iow_close:N \g__bgs_iow
  }
\ExplSyntaxOff

% \lean[<listings options>]{<tag>}: the code between `-- !begin <tag>` and `-- !end <tag>`.
\newcommand{\lean}[2][]{%
  \bgs@cut{\bgs@leanfile}{#2}%
  \begin{tcolorbox}[enhanced, colback=codebg, colframe=coderule, boxrule=0.4pt,
      leftrule=2.5pt, arc=1.5pt, left=4pt, right=4pt, top=1pt, bottom=1pt,
      borderline west={2.5pt}{0pt}{leanblue}]
    \lstinputlisting[#1]{\jobname-snippet.lean}%
  \end{tcolorbox}}

% Inline Lean: \lc{mul_comm}, or \lc|...| if the code contains braces. Plain code font.
% # and % are read as text, except inside another command's argument (\only{...}),
% where they are already read. The text is read again with _ ^ { } \ as plain
% characters, so that its Unicode symbols go through \newunicodechar.
\newcommand{\lc}{\begingroup\catcode`\#=12 \catcode`\%=12 \catcode`\^=12
  \@ifnextchar|{\bgs@lcbar}{\bgs@lcarg}}
\def\bgs@lcbar|{\catcode`\{=12 \catcode`\}=12 \bgs@lcbarB}
\def\bgs@lcbarB#1|{\bgs@lcset{#1}}
\def\bgs@lcarg#1{\bgs@lcset{#1}}
\def\bgs@lcset#1{\edef\bgs@lctext{\detokenize{#1}}%
  {\ttfamily\small \endlinechar=-1
   \catcode`\_=12 \catcode`\^=12 \catcode`\{=12 \catcode`\}=12 \catcode`\&=12
   \catcode`\$=12 \catcode`\~=12 \catcode`\#=12 \catcode`\%=12 \catcode`\\=12
   \expandafter\scantokens\expandafter{\bgs@lctext}}\endgroup}

% Goal display, styled after the Lean infoview. Body is Lean text, typed verbatim.
\newtcblisting{goal}[1][]{enhanced, listing only, listing options={style=bgslean},
  colback=goalbg, colframe=goalrule, boxrule=0.4pt, arc=1.5pt,
  left=4pt, right=4pt, top=1pt, bottom=1pt,
  title={\scriptsize\sffamily Lean infoview}, coltitle=ink, colbacktitle=goalrule!45,
  toptitle=0pt, bottomtitle=0pt, #1}

% Lean output (what #check / #eval print), typed verbatim.
\newtcblisting{leanout}[1][]{enhanced, listing only, listing options={style=bgslean},
  colback=white, colframe=coderule, boxrule=0.4pt, arc=1.5pt,
  left=4pt, right=4pt, top=1pt, bottom=1pt,
  title={\scriptsize\sffamily Lean says}, coltitle=muted, colbacktitle=codebg,
  toptitle=0pt, bottomtitle=0pt, #1}

